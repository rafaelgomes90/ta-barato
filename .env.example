# Duplique como .env e ajuste. O servidor carrega .env automaticamente no Node 22.13+ via --env-file.
PORT=3000
HOST=127.0.0.1
# Chave longa (exemplo: openssl rand -hex 32) para importar ofertas via endpoint admin.
ADMIN_IMPORT_TOKEN=
# Opcional: API Mercado Livre, com permissões correspondentes.
MERCADOLIVRE_ACCESS_TOKEN=
# Opcional: API oficial de afiliados Shopee, após aprovação.
SHOPEE_APP_ID=
SHOPEE_SECRET=
# Opcional: restringir origin CORS; chamadas de mesma origem funcionam por padrão.
PUBLIC_ORIGIN=https://tabarato.ofertadorafa.com.br
